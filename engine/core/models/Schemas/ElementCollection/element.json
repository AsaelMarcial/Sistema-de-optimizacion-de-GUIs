{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tu-proyecto.local/schemas/element-node.schema.json",
  "title": "ElementNode",
  "description": "Nodo del inventario de elementos basado en render, con relaciones por IDs para preservar unicidad e incrementalidad.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "elementId",
    "domPath",
    "xpath",
    "tag"
  ],
  "properties": {
    "elementId": {
      "type": "string"
    },
    "domPath": {
      "type": "string"
    },
    "xpath": {
      "type": [
        "string",
        "null"
      ]
    },
    "tag": {
      "type": "string"
    },
    "roleToken": {
      "type": [
        "string",
        "null"
      ]
    },
    "elementContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "childIndex": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "boundingBox": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "width": {
              "type": "number",
              "minimum": 0
            },
            "height": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "isVisible": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "display": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ]
        },
        "opacity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "hasStackingContext": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "paintOrder": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "effectiveBackgroundColor": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "rawValue": {
              "type": [
                "string",
                "null"
              ]
            },
            "colorRef": {
              "type": [
                "string",
                "null"
              ],
              "description": "Referencia a color.colorId del inventario de colores."
            }
          }
        }
      }
    },
    "colorProperties": {
      "type": "array",
      "description": "Propiedades de color efectivas en este elemento; cada item es un ColorProperty.",
      "items": {
        "$ref": "./property.json"
      },
      "uniqueItems": true
    },
    "childrenElementIds": {
      "type": "array",
      "description": "IDs de nodos hijos; cada valor debe ser un element-node.elementId.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
