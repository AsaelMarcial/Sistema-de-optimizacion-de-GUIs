{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tu-proyecto.local/schemas/style-rule.schema.json",
  "title": "StyleRule",
  "description": "Regla de estilo inventariada desde código fuente y/o complementada con CSSOM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "styleRuleId",
    "originType",
    "captureSource",
    "sheetOrder",
    "ruleOrder",
    "declarations"
  ],
  "properties": {
    "styleRuleId": {
      "type": "string",
      "description": "ID único de la regla; referenciado por color-property.winningStyleRef.styleRuleId."
    },
    "originType": {
      "type": "string",
      "enum": [
        "inline",
        "embedded",
        "external",
        "user-agent"
      ]
    },
    "captureSource": {
      "type": "string",
      "enum": [
        "source-code",
        "cssom",
        "hybrid"
      ]
    },
    "styleSheetId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sheetOrder": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ruleOrder": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "specificity": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "href": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "inlineOwnerElementId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sourceText": {
      "type": [
        "string",
        "null"
      ]
    },
    "declarations": {
      "type": "array",
      "description": "Declaraciones de color de esta regla; cada item referenciable por colorDeclarationId.",
      "items": {
        "$ref": "./declaration.json"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
